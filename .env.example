OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# SDK appends /chat/completions. Use the /v1 root, not .../v1/chat/completions.
OPENAI_BASE_URL=
# TOOLS | JSON_SCHEMA | MD_JSON
# Thinking models that reject tool_choice: MD_JSON
OPENAI_MODE=TOOLS
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
IMAGE_URL=
# Only for `pnpm example:extract-pdf`: a PDF file to extract text from.
# Unset, the example generates a small invoice PDF in memory.
PDF_PATH=

# Read by the examples and by `pnpm test:live`. The live suite also needs
# RUBRIC_LIVE=1, which the test:live script sets; without a key it skips.
