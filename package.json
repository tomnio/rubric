{
  "name": "@tomnio/rubric",
  "version": "0.6.0",
  "description": "Schema-first structured extraction from LLMs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:extract-user": "tsx examples/extract-user.ts",
    "example:extract-image": "tsx examples/extract-image.ts",
    "example:extract-user-anthropic": "tsx examples/extract-user-anthropic.ts",
    "example:extract-image-anthropic": "tsx examples/extract-image-anthropic.ts",
    "example:extract-document": "tsx examples/extract-document.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomnio/rubric.git"
  },
  "homepage": "https://github.com/tomnio/rubric#readme",
  "bugs": {
    "url": "https://github.com/tomnio/rubric/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.39.0",
    "@chonkiejs/core": ">=0.0.11",
    "@google/genai": ">=1.0.0",
    "openai": ">=4.0.0",
    "zod": "^3.24.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@chonkiejs/core": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chonkiejs/core": "^0.0.11",
    "@google/genai": "^1.0.0",
    "@anthropic-ai/sdk": "^0.125.0",
    "@types/node": "^20.19.43",
    "openai": "^4.104.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zod": "^3.24.0"
  },
  "dependencies": {
    "partial-json": "^0.1.7"
  }
}
